{
  "name": "quickasr",
  "version": "0.0.0",
  "description": "Low-latency speech-to-text runtime for consumer hardware, running Qwen3-ASR (prebuilt CLI binary)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexustar/quickasr.git"
  },
  "homepage": "https://github.com/nexustar/quickasr",
  "keywords": ["asr", "streaming", "speech-to-text", "qwen", "qwen3-asr", "transcription"],
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "quickasr": "bin/quickasr.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin",
    "LICENSE"
  ],
  "os": ["linux", "darwin", "win32"],
  "cpu": ["x64", "arm64"],
  "engines": {
    "node": ">=16"
  },
  "optionalDependencies": {
    "@quickasr/darwin-arm64": "0.0.0",
    "@quickasr/darwin-x64": "0.0.0",
    "@quickasr/linux-x64": "0.0.0",
    "@quickasr/linux-arm64": "0.0.0",
    "@quickasr/win32-x64": "0.0.0"
  }
}
